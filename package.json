{
    "$schema": "https://www.raycast.com/schemas/extension.json",
    "name": "image-picker-ext",
    "version": "2.2.0",
    "title": "Image Picker",
    "description": "Browse, preview, copy, and paste images from directories",
    "icon": "icon.png",
    "author": "dfs",
    "categories": [
        "Media"
    ],
    "license": "MIT",
    "platforms": [
        "Windows"
    ],
    "commands": [
        {
            "name": "image-picker",
            "title": "Browse Images",
            "description": "Browse, preview, copy, and paste images from directories",
            "mode": "view"
        }
    ],
    "preferences": [
        {
            "name": "directory1",
            "title": "Directory 1",
            "description": "First directory containing supported images",
            "type": "directory",
            "required": true
        },
        {
            "name": "directory2",
            "title": "Directory 2 (Optional)",
            "description": "Second directory path containing images to browse",
            "type": "directory",
            "required": false
        },
        {
            "name": "directory3",
            "title": "Directory 3 (Optional)",
            "description": "Third directory path containing images to browse",
            "type": "directory",
            "required": false
        },
        {
            "name": "directory4",
            "title": "Directory 4 (Optional)",
            "description": "Fourth directory path containing images to browse",
            "type": "directory",
            "required": false
        },
        {
            "name": "directory5",
            "title": "Directory 5 (Optional)",
            "description": "Fifth directory path containing images to browse",
            "type": "directory",
            "required": false
        },
        {
            "name": "scanSubdirectories",
            "title": "Scan Subdirectories",
            "description": "Include images from nested folders",
            "type": "checkbox",
            "label": "Search for images recursively",
            "required": false,
            "default": true
        },
        {
            "name": "defaultDirectory",
            "title": "Default Directory",
            "description": "Which directory to show by default when opening the extension",
            "type": "dropdown",
            "required": false,
            "default": "all",
            "data": [
                {
                    "title": "All Directories",
                    "value": "all"
                },
                {
                    "title": "Favorites",
                    "value": "favorites"
                },
                {
                    "title": "Recently Used",
                    "value": "recent"
                },
                {
                    "title": "Directory 1",
                    "value": "directory1"
                },
                {
                    "title": "Directory 2",
                    "value": "directory2"
                },
                {
                    "title": "Directory 3",
                    "value": "directory3"
                },
                {
                    "title": "Directory 4",
                    "value": "directory4"
                },
                {
                    "title": "Directory 5",
                    "value": "directory5"
                }
            ]
        },
        {
            "name": "sortOrder",
            "title": "Image Sorting",
            "description": "Default order used when browsing images",
            "type": "dropdown",
            "required": false,
            "default": "nameAsc",
            "data": [
                {
                    "title": "Name (A–Z)",
                    "value": "nameAsc"
                },
                {
                    "title": "Name (Z–A)",
                    "value": "nameDesc"
                },
                {
                    "title": "Recently Modified",
                    "value": "modifiedDesc"
                },
                {
                    "title": "Largest Files",
                    "value": "sizeDesc"
                }
            ]
        },
        {
            "name": "enableCache",
            "title": "Enable Image Cache",
            "description": "Cache scanned images for faster loading. Disable to always scan directories fresh.",
            "type": "checkbox",
            "label": "Cache images for faster loading",
            "required": false,
            "default": true
        }
    ],
    "dependencies": {
        "@raycast/api": "^2.7.2"
    },
    "devDependencies": {
        "@raycast/eslint-config": "^2.2.0",
        "@types/node": "22.19.17",
        "@types/react": "19.0.10",
        "eslint": "^9.39.4",
        "prettier": "^3.6.2",
        "typescript": "^5.9.3"
    },
    "scripts": {
        "build": "ray build -e dist",
        "dev": "ray develop",
        "fix-lint": "ray lint --fix",
        "lint": "ray lint",
        "publish": "ray publish"
    }
}
